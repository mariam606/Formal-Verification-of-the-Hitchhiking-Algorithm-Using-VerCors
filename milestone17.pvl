pure int imax(int a, int b) = a > b ? a : b;
decreases;
pure int BOTTOM() = -2;
decreases;
pure int EPSILON() = -1;

requires 0 <= k && k <= |xs|;
requires (\forall int i; 0 <= i && i < |xs|; BOTTOM() <= xs[i] && xs[i] < n);
ensures 0 <= \result;
ensures \result <= k * (n - BOTTOM() - 1);
decreases k;
pure int prefixSum(seq<int> xs, int k, int n) =
    k == 0 ? 0 : prefixSum(xs, k - 1, n) + (xs[k - 1] - BOTTOM());

requires 0 <= idx && idx < |xs|;
requires 0 <= k && k <= |xs|;
requires BOTTOM() <= v && v < n;
requires (\forall int i; 0 <= i && i < |xs|; BOTTOM() <= xs[i] && xs[i] < n);
ensures k <= idx ==> prefixSum(xs[idx -> v], k, n) == prefixSum(xs, k, n);
ensures k > idx ==> prefixSum(xs[idx -> v], k, n) == prefixSum(xs, k, n) - xs[idx] + v;
decreases k;
void lemma_prefixSum_update(seq<int> xs, int idx, int v, int k, int n) {
    if (k == 0) {
    } else {
        lemma_prefixSum_update(xs, idx, v, k - 1, n);
    }
}

requires n >= 0;
ensures |\result| == n;
ensures (\forall int i; 0 <= i && i < n; {:\result[i]:} == BOTTOM());
decreases n;
pure seq<int> allBottomSeq(int n) =
    n == 0 ? seq<int>{} : allBottomSeq(n - 1) + seq<int>{BOTTOM()};

requires 0 <= k && k <= n;
requires |seq_x| == n;
requires (\forall int i; 0 <= i && i < n; seq_x[i] == BOTTOM());
ensures prefixSum(seq_x, k, n) == 0;
decreases k;
void lemma_allBottom_sum_zero(seq<int> seq_x, int k, int n) {
    if (k == 0) {
    } else {
        lemma_allBottom_sum_zero(seq_x, k - 1, n);
    }
}

requires 0 <= u && u < |R| - 1;
requires 0 <= R[u] && R[u+1] <= |C|;
pure bool isEdge(seq<int> R, seq<int> C, int u, int v) =
    (\exists int j; R[u] <= j && j < R[u+1]; {:C[j]:} == v);

// number of successors of node u in CSR
inline pure int degree(seq<int> R, int u) = R[u+1] - R[u];

inline pure bool validGraph(int N, seq<int> R, seq<int> C) =
    |R| == N + 1 &&
    R[0] == 0 &&
    |C| == R[N] &&
    (\forall int u; 0 <= u && u < N; {:R[u]:} <= R[u+1]) &&
    (\forall int u; 0 <= u && u <= N; 0 <= {:R[u]:} && R[u] <= |C|) &&
    (\forall int i; 0 <= i && i < |C|; 0 <= {:C[i]:} && C[i] < N);

requires validGraph(N, R, C);
inline pure bool isAPath(int N, seq<int> R, seq<int> C, seq<int> path) =
    |path| > 0 &&
    (\forall int i; 0 <= i && i < |path|; 0 <= {:path[i]:} && path[i] < N) &&
    (\forall int i; 0 <= i && i < |path| - 1; isEdge(R, C, {:path[i]:}, path[i+1]));

requires validGraph(N, R, C);
requires |is_red| == N;
inline pure bool isAcceptingCycle(int N, seq<int> R, seq<int> C, seq<int> is_red, seq<int> path) =
    isAPath(N, R, C, path) &&
    isEdge(R, C, path[|path| - 1], path[0]) &&
    (\exists int i; 0 <= i && i < |path|; is_red[{:path[i]:}] == 1);

inline pure bool arr(int[] a, int n) = a != null && a.length == n;

inline pure bool allEq(int[] a, int n, int val) =
    (\forall int v; 0 <= v && v < n; {:a[v]:} == val);

inline pure bool validInput(int num_nodes, seq<int> is_red, seq<int> R, seq<int> C) =
    num_nodes > 0 &&
    |is_red| == num_nodes &&
    validGraph(num_nodes, R, C) &&
    (\forall int v; 0 <= v && v < num_nodes; {:is_red[v]:} == 0 || is_red[v] == 1);

inline pure bool validRoots(int num_roots, seq<int> roots, int num_nodes) =
    num_roots > 0 && |roots| == num_roots &&
    (\forall int i; 0 <= i && i < num_roots; 0 <= {:roots[i]:} && roots[i] < num_nodes);

inline pure bool flags01(int[] a, int n) =
    (\forall int v; 0 <= v && v < n; {:a[v]:} == 0 || a[v] == 1);

inline pure bool pWellFormed(int[] p, seq<int> is_red, int n) =
    (\forall int v; 0 <= v && v < n;
        {:p[v]:} == BOTTOM() || p[v] == EPSILON() || (0 <= p[v] && p[v] < n)) &&
    (\forall int v; 0 <= v && v < n;
        (0 <= {:p[v]:} && p[v] < n) ==> is_red[p[v]] == 1);

inline pure bool activeImpliesRed(int[] in_active, seq<int> is_red, int n) =
    (\forall int v; 0 <= v && v < n; {:in_active[v]:} == 1 ==> is_red[v] == 1);

inline pure bool queueOk(seq<int> q, int[] p, int n) =
    (\forall int j; 0 <= j && j < |q|; 0 <= {:q[j]:} && q[j] < n) &&
    (\forall int j; 0 <= j && j < |q|; {:p[q[j]]:} != BOTTOM());

inline pure bool ghostPathsOk(int n, seq<int> R, seq<int> C, seq<int>[] ghost_path, int[] p) =
    (\forall int v; 0 <= v && v < n;
        (0 <= {:p[v]:} && p[v] < n) ==>
            |ghost_path[v]| >= 1 &&
            ghost_path[v][0] == p[v] &&
            ghost_path[v][|ghost_path[v]| - 1] == v &&
            (\forall int i; 0 <= i && i < |ghost_path[v]|;
                0 <= {:ghost_path[v][i]:} && ghost_path[v][i] < n) &&
            (\forall int i; 0 <= i && i < |ghost_path[v]| - 1;
                isEdge(R, C, {:ghost_path[v][i]:}, ghost_path[v][i+1])));

inline pure bool maxActiveOk(int[] p, int[] in_active, int m, int n) =
    (m == BOTTOM() || (0 <= m && m < n)) &&
    (\forall int w; 0 <= w && w < n; {:p[w]:} >= 0 ==> p[w] <= m) &&
    (\forall int v; 0 <= v && v < n; {:in_active[v]:} == 1 ==> v <= m);

inline pure bool stateInv(int n, seq<int> R, seq<int> C, seq<int> is_red, seq<int> q,
                          int[] p, int[] in_active, seq<int>[] ghost_path, int m) =
    queueOk(q, p, n) &&
    pWellFormed(p, is_red, n) &&
    activeImpliesRed(in_active, is_red, n) &&
    ghostPathsOk(n, R, C, ghost_path, p) &&
    maxActiveOk(p, in_active, m, n);

// check if there are interrupted nodes
requires n >= 0;
context in_interrupted != null && in_interrupted.length == n;
context Perm(in_interrupted[*], write);
ensures (\forall int i; 0 <= i && i < n; {:in_interrupted[i]:} == \old(in_interrupted[i]));
ensures \result == (\exists int i; 0 <= i && i < n; {:in_interrupted[i]:} == 1);
bool anyInterrupted(int n, int[] in_interrupted) {
    bool found_any = false;
    int chk = 0;
    loop_invariant Perm(in_interrupted[*], write);
    loop_invariant 0 <= chk && chk <= n;
    loop_invariant (\forall int i; 0 <= i && i < n; {:in_interrupted[i]:} == \old(in_interrupted[i]));
    loop_invariant found_any == (\exists int i; 0 <= i && i < chk; {:in_interrupted[i]:} == 1);
    decreases n - chk;
    while (chk < n) {
        if (in_interrupted[chk] == 1) { found_any = true; }
        chk = chk + 1;
    }
    return found_any;
}

// process the roots, returns the queue of open nodes
context_everywhere validInput(num_nodes, is_red, R, C);
context_everywhere validRoots(num_roots, roots, num_nodes);
context_everywhere arr(p, num_nodes) && arr(in_open, num_nodes) && arr(in_active, num_nodes);
context_everywhere ghost_path != null && ghost_path.length == num_nodes;
context Perm(p[*],          write);
context Perm(in_open[*],    write);
context Perm(in_active[*],  write);
context Perm(ghost_path[*], write);
requires allEq(p, num_nodes, BOTTOM()) && allEq(in_open, num_nodes, 0) && allEq(in_active, num_nodes, 0);
yields int max_active_out;
yields seq<int> p_seq_out;
yields int sum_p_out;
ensures flags01(in_open, num_nodes);
ensures flags01(in_active, num_nodes);
ensures stateInv(num_nodes, R, C, is_red, \result, p, in_active, ghost_path, max_active_out);
ensures |p_seq_out| == num_nodes;
ensures (\forall int i; 0 <= i && i < num_nodes; {:p_seq_out[i]:} == p[i]);
ensures (\forall int i; 0 <= i && i < num_nodes; BOTTOM() <= p_seq_out[i] && p_seq_out[i] < num_nodes);
ensures sum_p_out == prefixSum(p_seq_out, num_nodes, num_nodes);
ensures 0 <= sum_p_out && sum_p_out <= num_nodes * (num_nodes + 1);
ensures (\forall int w; 0 <= w && w < num_nodes; 0 <= {:p[w]:} && p[w] < num_nodes ==> in_active[p[w]] == 1);
seq<int> processRoots(int num_nodes, int num_roots, seq<int> roots, seq<int> is_red,
                      seq<int> R, seq<int> C,
                      int[] p, int[] in_open, int[] in_active, seq<int>[] ghost_path)
{
    ghost max_active_out = BOTTOM();
    ghost p_seq_out = allBottomSeq(num_nodes);
    lemma_allBottom_sum_zero(p_seq_out, num_nodes, num_nodes);
    ghost sum_p_out = 0;
    seq<int> open_queue = seq<int>{};
    int ri = 0;
    loop_invariant Perm(p[*],          write);
    loop_invariant Perm(in_open[*],    write);
    loop_invariant Perm(in_active[*],  write);
    loop_invariant Perm(ghost_path[*], write);
    loop_invariant 0 <= ri && ri <= num_roots;
    loop_invariant |open_queue| <= ri;
    loop_invariant flags01(in_open, num_nodes);
    loop_invariant flags01(in_active, num_nodes);
    loop_invariant stateInv(num_nodes, R, C, is_red, open_queue, p, in_active, ghost_path, max_active_out);
    loop_invariant |p_seq_out| == num_nodes;
    loop_invariant (\forall int i; 0 <= i && i < num_nodes; {:p_seq_out[i]:} == p[i]);
    loop_invariant (\forall int i; 0 <= i && i < num_nodes; BOTTOM() <= p_seq_out[i] && p_seq_out[i] < num_nodes);
    loop_invariant sum_p_out == prefixSum(p_seq_out, num_nodes, num_nodes);
    loop_invariant 0 <= sum_p_out && sum_p_out <= num_nodes * (num_nodes + 1);
    loop_invariant (\forall int w; 0 <= w && w < num_nodes; 0 <= {:p[w]:} && p[w] < num_nodes ==> in_active[p[w]] == 1);
    decreases num_roots - ri;
    while (ri < num_roots) {
        int r = roots[ri];
        if (in_open[r] == 0) {
            open_queue = open_queue + [r];
            in_open[r] = 1;
        }
        int old_pr = p[r];
        int new_pr;
        if (is_red[r] == 1) {
            in_active[r] = 1;
            ghost if (r > max_active_out) { max_active_out = r; }
            p[r] = r;
            new_pr = r;
            ghost ghost_path[r] = [r];
        } else {
            p[r] = EPSILON();
            new_pr = EPSILON();
            ghost ghost_path[r] = seq<int>{};
        }
        ghost seq<int> p_seq_before = p_seq_out;
        ghost p_seq_out = p_seq_out[r -> new_pr];
        lemma_prefixSum_update(p_seq_before, r, new_pr, num_nodes, num_nodes);
        ghost sum_p_out = sum_p_out + (new_pr - old_pr);
        ri = ri + 1;
    }
    return open_queue;
}

// post-processing
context_everywhere validInput(num_nodes, is_red, R, C);
context_everywhere arr(p, num_nodes) && arr(in_open, num_nodes) &&
                   arr(in_active, num_nodes) && arr(in_interrupted, num_nodes);
context_everywhere ghost_path != null && ghost_path.length == num_nodes;
context Perm(p[*],              write);
context Perm(in_open[*],        write);
context Perm(in_active[*],      write);
context Perm(in_interrupted[*], write);
context Perm(ghost_path[*],     write);
given int max_active_in;
yields int max_active_out;
requires flags01(in_open, num_nodes);
requires flags01(in_active, num_nodes);
requires flags01(in_interrupted, num_nodes);
requires stateInv(num_nodes, R, C, is_red, open_queue, p, in_active, ghost_path, max_active_in);
requires max_active_in == BOTTOM() || in_interrupted[max_active_in] == 0;
requires (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 1 ==> in_active[i] == 1);
ensures |\result| >= |open_queue|;
ensures flags01(in_open, num_nodes);
ensures flags01(in_active, num_nodes);
ensures flags01(in_interrupted, num_nodes);
ensures stateInv(num_nodes, R, C, is_red, \result, p, in_active, ghost_path, max_active_out);
ensures max_active_in == BOTTOM() || max_active_out < max_active_in;
ensures (\forall int v; 0 <= v && v < num_nodes; {:p[v]:} != BOTTOM());
ensures (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 1 ==> in_active[i] == 1);
ensures (\forall int w; 0 <= w && w < num_nodes; 0 <= {:p[w]:} && p[w] < num_nodes ==> in_active[p[w]] == 1);
ensures (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 0);
given seq<int> p_seq_in;
given int sum_p_in;
yields seq<int> p_seq_out;
yields int sum_p_out;
requires |p_seq_in| == num_nodes;
requires (\forall int i; 0 <= i && i < num_nodes; {:p_seq_in[i]:} == p[i]);
requires (\forall int i; 0 <= i && i < num_nodes; BOTTOM() <= p_seq_in[i] && p_seq_in[i] < num_nodes);
requires sum_p_in == prefixSum(p_seq_in, num_nodes, num_nodes);
requires 0 <= sum_p_in && sum_p_in <= num_nodes * (num_nodes + 1);
ensures |p_seq_out| == num_nodes;
ensures (\forall int i; 0 <= i && i < num_nodes; {:p_seq_out[i]:} == p[i]);
ensures (\forall int i; 0 <= i && i < num_nodes; BOTTOM() <= p_seq_out[i] && p_seq_out[i] < num_nodes);
ensures sum_p_out == prefixSum(p_seq_out, num_nodes, num_nodes);
ensures 0 <= sum_p_out && sum_p_out <= num_nodes * (num_nodes + 1);
seq<int> resetActive(int num_nodes, seq<int> is_red,
                     seq<int> R, seq<int> C, seq<int> open_queue,
                     int[] p, int[] in_open, int[] in_active, int[] in_interrupted,
                     seq<int>[] ghost_path)
{
    ghost max_active_out = BOTTOM();
    ghost p_seq_out = p_seq_in;
    ghost sum_p_out = sum_p_in;
    seq<int> q = open_queue;
    int v = 0;
    loop_invariant Perm(p[*],              write);
    loop_invariant Perm(in_open[*],        write);
    loop_invariant Perm(in_active[*],      write);
    loop_invariant Perm(in_interrupted[*], write);
    loop_invariant Perm(ghost_path[*],     write);
    loop_invariant 0 <= v && v <= num_nodes;
    loop_invariant |q| >= |open_queue|;
    loop_invariant flags01(in_open, num_nodes);
    loop_invariant flags01(in_active, num_nodes);
    loop_invariant flags01(in_interrupted, num_nodes);
    loop_invariant (\forall int w; 0 <= w && w < v; {:p[w]:} != BOTTOM());
    loop_invariant (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 1 ==> in_active[i] == 1);
    loop_invariant (\forall int w; 0 <= w && w < v; 0 <= {:p[w]:} && p[w] < num_nodes ==> in_active[p[w]] == 1);
    loop_invariant (\forall int i; 0 <= i && i < v; {:in_interrupted[i]:} == 0);
    loop_invariant stateInv(num_nodes, R, C, is_red, q, p, in_active, ghost_path, max_active_in);
    loop_invariant max_active_out == BOTTOM() || (0 <= max_active_out && max_active_out < num_nodes);
    loop_invariant (\forall int w; 0 <= w && w < v; {:in_active[w]:} == 1 ==> w <= max_active_out);
    loop_invariant (\forall int w; 0 <= w && w < v; {:p[w]:} >= 0 ==> p[w] <= max_active_out);
    loop_invariant max_active_out == BOTTOM() ||
                   (0 <= max_active_out && max_active_out < v && in_active[max_active_out] == 1);
    loop_invariant max_active_in == BOTTOM() ||
                   (v <= max_active_in ==> in_interrupted[max_active_in] == 0);
    loop_invariant max_active_in == BOTTOM() || v <= max_active_in || in_active[max_active_in] == 0;
    loop_invariant |p_seq_out| == num_nodes;
    loop_invariant (\forall int i; 0 <= i && i < num_nodes; {:p_seq_out[i]:} == p[i]);
    loop_invariant (\forall int i; 0 <= i && i < num_nodes; BOTTOM() <= p_seq_out[i] && p_seq_out[i] < num_nodes);
    loop_invariant sum_p_out == prefixSum(p_seq_out, num_nodes, num_nodes);
    loop_invariant 0 <= sum_p_out && sum_p_out <= num_nodes * (num_nodes + 1);
    decreases num_nodes - v;
    while (v < num_nodes) {
        if (in_active[v] == 1) {
            if (in_interrupted[v] == 1 && p[v] != v) {
                if (in_open[v] == 0) {
                    q = q + [v];
                    in_open[v] = 1;
                }
            } else {
                in_active[v] = 0;
            }
            in_interrupted[v] = 0;
        }
        int old_pv = p[v];
        int new_pv;
        if (in_active[v] == 1) {
            p[v] = v;
            new_pv = v;
            ghost if (v > max_active_out) { max_active_out = v; }
            ghost ghost_path[v] = [v];
        } else {
            p[v] = EPSILON();
            new_pv = EPSILON();
            ghost ghost_path[v] = seq<int>{};
        }
        ghost seq<int> p_seq_before = p_seq_out;
        ghost p_seq_out = p_seq_out[v -> new_pv];
        lemma_prefixSum_update(p_seq_before, v, new_pv, num_nodes, num_nodes);
        ghost sum_p_out = sum_p_out + (new_pv - old_pv);
        v = v + 1;
    }
    return q;
}

// process the children of a node
context_everywhere validInput(num_nodes, is_red, R, C);
context_everywhere arr(p, num_nodes) && arr(in_open, num_nodes) &&
                   arr(in_active, num_nodes) && arr(in_interrupted, num_nodes);
context_everywhere ghost_path != null && ghost_path.length == num_nodes;
context_everywhere found != null && found.length == 1;
context Perm(p[*],              write);
context Perm(in_open[*],        write);
context Perm(in_active[*],      write);
context Perm(in_interrupted[*], write);
context Perm(ghost_path[*],     write);
context Perm(found[*],          write);
given int sum_p_in;
given int max_active_in;
given seq<int> p_seq_in;
yields int sum_p_out;
yields int max_active_out;
yields seq<int> cycle_out;
yields seq<int> p_seq_out;
requires 0 <= node && node < num_nodes;
requires found[0] == 0;
requires 0 <= sum_p_in && sum_p_in <= num_nodes * (num_nodes + 1);
requires |p_seq_in| == num_nodes;
requires (\forall int i; 0 <= i && i < num_nodes; {:p_seq_in[i]:} == p[i]);
requires (\forall int i; 0 <= i && i < num_nodes; BOTTOM() <= p_seq_in[i] && p_seq_in[i] < num_nodes);
requires sum_p_in == prefixSum(p_seq_in, num_nodes, num_nodes);
requires flags01(in_open, num_nodes);
requires flags01(in_active, num_nodes);
requires flags01(in_interrupted, num_nodes);
requires stateInv(num_nodes, R, C, is_red, open_queue, p, in_active, ghost_path, max_active_in);
requires max_active_in == BOTTOM() ==> (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 0);
requires (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 1 ==> in_active[i] == 1);
requires (\forall int w; 0 <= w && w < num_nodes; 0 <= {:p[w]:} && p[w] < num_nodes ==> in_active[p[w]] == 1);
requires max_active_in == BOTTOM() || in_interrupted[max_active_in] == 0;
ensures max_active_out == BOTTOM() ==> (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 0);
ensures (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 1 ==> in_active[i] == 1);
ensures (\forall int w; 0 <= w && w < num_nodes; 0 <= {:p[w]:} && p[w] < num_nodes ==> in_active[p[w]] == 1);
ensures max_active_out == BOTTOM() || (0 <= max_active_out && max_active_out < num_nodes && in_interrupted[max_active_out] == 0);
ensures found[0] == 0 || found[0] == 1;
ensures |\result| >= |open_queue|;
ensures flags01(in_open, num_nodes);
ensures flags01(in_active, num_nodes);
ensures flags01(in_interrupted, num_nodes);
ensures stateInv(num_nodes, R, C, is_red, \result, p, in_active, ghost_path, max_active_out);
ensures |p_seq_out| == num_nodes;
ensures (\forall int i; 0 <= i && i < num_nodes; {:p_seq_out[i]:} == p[i]);
ensures (\forall int i; 0 <= i && i < num_nodes; BOTTOM() <= p_seq_out[i] && p_seq_out[i] < num_nodes);
ensures sum_p_out == prefixSum(p_seq_out, num_nodes, num_nodes);
ensures sum_p_out >= sum_p_in && sum_p_out <= num_nodes * (num_nodes + 1);
ensures sum_p_out - sum_p_in >= |\result| - |open_queue|;
ensures found[0] == 1 ==> isAcceptingCycle(num_nodes, R, C, is_red, cycle_out);
ensures (\forall int w; 0 <= w && w < num_nodes; \old(p[w]) != BOTTOM() ==> {:p[w]:} != BOTTOM());
ensures (\forall int w; 0 <= w && w < num_nodes; \old(p[w]) != BOTTOM()) ==> max_active_out == max_active_in;
seq<int> processNode(int num_nodes, seq<int> is_red,
                     seq<int> R, seq<int> C, int node, seq<int> open_queue,
                     int[] p, int[] in_open, int[] in_active, int[] in_interrupted,
                     int[] found, seq<int>[] ghost_path)
{
    ghost sum_p_out = sum_p_in;
    ghost max_active_out = max_active_in;
    ghost p_seq_out = p_seq_in;
    seq<int> q = open_queue;
    int ci = 0;
    loop_invariant Perm(p[*],              write);
    loop_invariant Perm(in_open[*],        write);
    loop_invariant Perm(in_active[*],      write);
    loop_invariant Perm(in_interrupted[*], write);
    loop_invariant Perm(ghost_path[*],     write);
    loop_invariant Perm(found[*],          write);
    loop_invariant found[0] == 0;
    loop_invariant 0 <= ci && ci <= degree(R, node);
    loop_invariant 0 <= R[node] && R[node] + degree(R, node) <= |C|;
    loop_invariant |q| >= |open_queue|;
    loop_invariant flags01(in_open, num_nodes);
    loop_invariant flags01(in_active, num_nodes);
    loop_invariant flags01(in_interrupted, num_nodes);
    loop_invariant (\forall int w; 0 <= w && w < num_nodes; \old(p[w]) != BOTTOM() ==> {:p[w]:} != BOTTOM());
    loop_invariant (\forall int w; 0 <= w && w < num_nodes; \old(p[w]) != BOTTOM()) ==> max_active_out == max_active_in;
    loop_invariant max_active_out == BOTTOM() ==> (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 0);
    loop_invariant (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 1 ==> in_active[i] == 1);
    loop_invariant (\forall int w; 0 <= w && w < num_nodes; 0 <= {:p[w]:} && p[w] < num_nodes ==> in_active[p[w]] == 1);
    loop_invariant max_active_out == BOTTOM() || (0 <= max_active_out && max_active_out < num_nodes && in_interrupted[max_active_out] == 0);
    loop_invariant stateInv(num_nodes, R, C, is_red, q, p, in_active, ghost_path, max_active_out);
    loop_invariant |p_seq_out| == num_nodes;
    loop_invariant (\forall int i; 0 <= i && i < num_nodes; {:p_seq_out[i]:} == p[i]);
    loop_invariant (\forall int i; 0 <= i && i < num_nodes; BOTTOM() <= p_seq_out[i] && p_seq_out[i] < num_nodes);
    loop_invariant sum_p_out == prefixSum(p_seq_out, num_nodes, num_nodes);
    loop_invariant sum_p_out >= sum_p_in && sum_p_out <= num_nodes * (num_nodes + 1);
    loop_invariant sum_p_out - sum_p_in >= |q| - |open_queue|;
    decreases degree(R, node) - ci;
    while (ci < degree(R, node)) {
        int alpha = p[node];
        int child = C[R[node] + ci];
        assert isEdge(R, C, node, child);

        // line 13: accepting cycle — exit early
        if (alpha == child) {
            found[0] = 1;
            assert is_red[child] == 1;
            assert ghost_path[node][0] == child;
            assert ghost_path[node][|ghost_path[node]| - 1] == node;
            ghost cycle_out = ghost_path[node];
            assert |cycle_out| >= 1;
            assert (\forall int i; 0 <= i && i < |cycle_out|;
                        0 <= {:cycle_out[i]:} && cycle_out[i] < num_nodes);
            assert (\forall int i; 0 <= i && i < |cycle_out| - 1;
                        isEdge(R, C, {:cycle_out[i]:}, cycle_out[i+1]));
            assert isEdge(R, C, cycle_out[|cycle_out| - 1], cycle_out[0]);
            assert is_red[cycle_out[0]] == 1;
            return q;
        }

        // lines 14-17: first visit to a red child
        if (p[child] == BOTTOM() && is_red[child] == 1) {
            in_active[child] = 1;
            ghost if (child > max_active_out) { max_active_out = child; }
            if (child > alpha) {
                alpha = child;
            } else {
                in_interrupted[child] = 1;
            }
        }

        // line 18: atomic max update of p[child]
        int beta = p[child];
        assert 0 <= child && child < num_nodes;
        ghost seq<int> p_seq_before = p_seq_out;
        p[child] = imax(alpha, beta);
        ghost p_seq_out = p_seq_out[child -> p[child]];
        lemma_prefixSum_update(p_seq_before, child, p[child], num_nodes, num_nodes);
        ghost if (alpha > beta) {
            ghost sum_p_out = sum_p_out + alpha - beta;
        }

        // line 19: 2nd interruption
        if (alpha > beta && beta > EPSILON() && in_open[child] == 1) {
            in_interrupted[beta] = 1;
        }

        // line 20: 3rd interruption
        if (beta > alpha && alpha > EPSILON() && in_active[child] == 0) {
            in_interrupted[alpha] = 1;
        }

        // line 21: reopen child if p grew (deduplicated via in_open check)
        if (alpha > beta && in_open[child] == 0) {
            q = q + [child];
            in_open[child] = 1;
        }

        ghost if (p[child] == child) {
            ghost_path[child] = [child];
        } else ghost if (p[child] == p[node] && p[child] >= 0) {
                ghost_path[child] = ghost_path[node] + [child];
        }

        ci = ci + 1;
    }
    return q;
}

// check correct inputs, permissions, initial states
context_everywhere validInput(num_nodes, is_red, R, C);
context_everywhere validRoots(num_roots, roots, num_nodes);
context_everywhere arr(p, num_nodes) && arr(in_open, num_nodes) &&
                   arr(in_active, num_nodes) && arr(in_interrupted, num_nodes);
context Perm(p[*],              write);
context Perm(in_open[*],        write);
context Perm(in_active[*],      write);
context Perm(in_interrupted[*], write);
requires allEq(p, num_nodes, BOTTOM()) && allEq(in_open, num_nodes, 0) &&
         allEq(in_active, num_nodes, 0) && allEq(in_interrupted, num_nodes, 0);

// soundness check: if returns true -> there exists a cycle
yields seq<int> cycle;
ensures \result ==> isAcceptingCycle(num_nodes, R, C, is_red, cycle);

bool hitchhiking(
    int num_nodes,
    int num_roots,
    seq<int> roots,
    seq<int> is_red,
    seq<int> R,
    seq<int> C,
    int[] p,
    int[] in_open,
    int[] in_active,
    int[] in_interrupted
) {
    ghost seq<int>[] ghost_path = new seq<int>[num_nodes];
    ghost int max_active = BOTTOM();
    ghost seq<int> p_seq = allBottomSeq(num_nodes);
    ghost int sum_p = 0;
    int[] found = new int[1];
    found[0] = 0;
    int ptr = 0;

    seq<int> open_queue = processRoots(num_nodes, num_roots, roots, is_red, R, C,
                                       p, in_open, in_active, ghost_path)
                          yields { max_active = max_active_out, p_seq = p_seq_out, sum_p = sum_p_out };
    
    ghost int max_active_end_round = num_nodes;
    ghost bool reset_happened = false;
    ghost int max_active_after_reset = BOTTOM();

    loop_invariant Perm(p[*],              write);
    loop_invariant Perm(in_open[*],        write);
    loop_invariant Perm(in_active[*],      write);
    loop_invariant Perm(in_interrupted[*], write);
    loop_invariant Perm(ghost_path[*],     write);
    loop_invariant Perm(found[*],          write);
    loop_invariant found[0] == 0;
    loop_invariant 0 <= ptr && ptr <= |open_queue|;
    loop_invariant flags01(in_open, num_nodes);
    loop_invariant flags01(in_active, num_nodes);
    loop_invariant flags01(in_interrupted, num_nodes);
    loop_invariant max_active == BOTTOM() ==> (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 0);
    loop_invariant (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 1 ==> in_active[i] == 1);
    loop_invariant (\forall int w; 0 <= w && w < num_nodes; 0 <= {:p[w]:} && p[w] < num_nodes ==> in_active[p[w]] == 1);
    loop_invariant max_active == BOTTOM() || (0 <= max_active && max_active < num_nodes && in_interrupted[max_active] == 0);
    loop_invariant reset_happened ==> (\forall int v; 0 <= v && v < num_nodes; {:p[v]:} != BOTTOM());
    loop_invariant reset_happened ==> max_active == max_active_after_reset;
    loop_invariant (ptr < |open_queue| && reset_happened) ==> max_active_after_reset < max_active_end_round;
    loop_invariant (ptr < |open_queue| && !reset_happened) ==> max_active_end_round == num_nodes;
    loop_invariant stateInv(num_nodes, R, C, is_red, open_queue, p, in_active, ghost_path, max_active);
    loop_invariant |p_seq| == num_nodes;
    loop_invariant (\forall int i; 0 <= i && i < num_nodes; {:p_seq[i]:} == p[i]);
    loop_invariant (\forall int i; 0 <= i && i < num_nodes; BOTTOM() <= p_seq[i] && p_seq[i] < num_nodes);
    loop_invariant sum_p == prefixSum(p_seq, num_nodes, num_nodes);
    loop_invariant sum_p >= 0 && sum_p <= num_nodes * (num_nodes + 1);
    decreases max_active_end_round - BOTTOM();
    while (ptr < |open_queue|) {

        loop_invariant Perm(p[*],              write);
        loop_invariant Perm(in_open[*],        write);
        loop_invariant Perm(in_active[*],      write);
        loop_invariant Perm(in_interrupted[*], write);
        loop_invariant Perm(ghost_path[*],     write);
        loop_invariant Perm(found[*],          write);
        loop_invariant found[0] == 0;
        loop_invariant 0 <= ptr && ptr <= |open_queue|;
        loop_invariant flags01(in_open, num_nodes);
        loop_invariant flags01(in_active, num_nodes);
        loop_invariant flags01(in_interrupted, num_nodes);
        loop_invariant max_active == BOTTOM() ==> (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 0);
        loop_invariant (\forall int i; 0 <= i && i < num_nodes; {:in_interrupted[i]:} == 1 ==> in_active[i] == 1);
        loop_invariant (\forall int w; 0 <= w && w < num_nodes; 0 <= {:p[w]:} && p[w] < num_nodes ==> in_active[p[w]] == 1);
        loop_invariant max_active == BOTTOM() || (0 <= max_active && max_active < num_nodes && in_interrupted[max_active] == 0);
        loop_invariant reset_happened ==> (\forall int v; 0 <= v && v < num_nodes; {:p[v]:} != BOTTOM());
        loop_invariant reset_happened ==> max_active == max_active_after_reset;
        loop_invariant (ptr < |open_queue| && reset_happened) ==> max_active_after_reset < max_active_end_round;
        loop_invariant (ptr < |open_queue| && !reset_happened) ==> max_active_end_round == num_nodes;
        loop_invariant stateInv(num_nodes, R, C, is_red, open_queue, p, in_active, ghost_path, max_active);
        loop_invariant |p_seq| == num_nodes;
        loop_invariant (\forall int i; 0 <= i && i < num_nodes; {:p_seq[i]:} == p[i]);
        loop_invariant sum_p == prefixSum(p_seq, num_nodes, num_nodes);
        loop_invariant sum_p >= 0 && sum_p <= num_nodes * (num_nodes + 1);
        decreases num_nodes * (num_nodes + 1) - sum_p, |open_queue| - ptr;

        while (ptr < |open_queue|) {
            int node = open_queue[ptr];
            ptr = ptr + 1;
            in_open[node] = 0;

            open_queue = processNode(num_nodes, is_red, R, C, node, open_queue,
                                     p, in_open, in_active, in_interrupted, found, ghost_path)
                         given  { sum_p_in = sum_p, max_active_in = max_active, p_seq_in = p_seq }
                         yields { sum_p = sum_p_out, max_active = max_active_out, cycle = cycle_out, p_seq = p_seq_out };

            if (found[0] == 1) {
                return true; // a counter example found
            }
        }

        max_active_end_round = max_active;
        assert max_active_end_round == BOTTOM() || (0 <= max_active_end_round && max_active_end_round < num_nodes && in_interrupted[max_active_end_round] == 0);

        bool any_interrupted = anyInterrupted(num_nodes, in_interrupted);

        // lines 23-28 in the pseudocode
        if (any_interrupted) {
            open_queue = resetActive(num_nodes, is_red, R, C, open_queue,
                                     p, in_open, in_active, in_interrupted, ghost_path)
                         given { max_active_in = max_active, p_seq_in = p_seq, sum_p_in = sum_p }
                         yields { max_active = max_active_out, p_seq = p_seq_out, sum_p = sum_p_out };
            ghost max_active_after_reset = max_active;
            ghost reset_happened = true;
        }
    }

    return false; // no counter example found
}
